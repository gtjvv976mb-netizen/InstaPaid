# Where the server listens and how people reach it (used in token metadata, replies, the poster's
# card links, and the extension). Must be https for the auto-poster: Instagram fetches the card from it.
PORT=8787
PUBLIC_URL=https://instapaid.fun
# Behind a proxy (Render, a load balancer): 1, so rate limits see the real address.
TRUST_PROXY=0

# Solana
RPC_URL=https://api.mainnet-beta.solana.com
# Server hot wallet (base58 or JSON array secret key). Pays claim network fees and comment
# launches. Web/extension launches are paid by the launcher's own wallet.
FEE_PAYER_SECRET=

# 32 random bytes, hex (openssl rand -hex 32). Encrypts every Instagram account's vault key at rest.
# Lose it and every unclaimed fee is lost. Rotate only with a re-encryption.
VAULT_MASTER_KEY=
# 32 random bytes, hex. Signs claim sessions.
SESSION_SECRET=

# Optional platform cut of each claim, in basis points (0 = none), sent to TREASURY_ADDRESS.
PLATFORM_FEE_BPS=0
TREASURY_ADDRESS=

# Instagram: the Instagram API with Instagram Login, on the bot's own Business or Creator account
# (no Facebook Page). One token does everything: claim codes by DM, comment launches (reading the
# post, replying under the comment) and the auto-poster. Its permissions: instagram_business_basic,
# instagram_business_manage_messages, instagram_business_manage_comments,
# instagram_business_content_publish. The bot's Instagram id is read from the token at start
# (GET /me?fields=user_id,username); no IG_USER_ID is needed.
# The token lasts 60 days and the server renews it itself (24 hours after a new one is pasted, then
# every 7 days; kept in the database, sealed with VAULT_MASTER_KEY). Paste a new one here only if the logs say "instagram token: WARNING";
# a new IG_ACCESS_TOKEN always wins over the stored one.
IG_BOT_USERNAME=instapaid.official
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=
IG_GRAPH_VERSION=v23.0
# Staging only: a stand-in for https://graph.instagram.com. https, or http on localhost.
# IG_GRAPH_BASE_URL=http://127.0.0.1:9999
# Optional: the Instagram app ID (Meta app → Instagram → API setup with Instagram login). Turns on the
# owner's page /admin: sign in with Instagram as @IG_BOT_USERNAME (and no one else) to moderate
# comments on the bot's posts. Add <PUBLIC_URL>/admin/callback under Business login settings →
# OAuth redirect URIs. Unset, /admin says it is not configured.
IG_APP_ID=
# Staging only: a stand-in for https://api.instagram.com (the /admin sign-in's code exchange).
# IG_OAUTH_BASE_URL=http://127.0.0.1:9999

# Comment launches: "@<IG_BOT_USERNAME> make a token ..." under any public post. On whenever
# IG_ACCESS_TOKEN is set; 0 switches them off without removing the token. The webhook must be
# subscribed to "comments" (the server subscribes the account at start).
COMMENT_LAUNCHES=1

# Optional, legacy: the Instagram API with Facebook Login instead (a Facebook Page linked to the
# bot, instagram_basic, instagram_manage_comments, instagram_content_publish, pages_* permissions,
# the webhook's "mentions" field). Used only when BOTH are set: then the auto-poster publishes with
# this token, and comment reads and replies fall back to it. Leave both empty on Instagram Login.
IG_USER_ID=
IG_FB_ACCESS_TOKEN=
FB_GRAPH_VERSION=v23.0
# Staging only: a stand-in for https://graph.facebook.com (the Facebook Login path).
# https, or http on localhost. Leave it unset in production.
# GRAPH_BASE_URL=http://127.0.0.1:9999
# Optional: the Meta app's own secret (App settings → Basic), if it differs from IG_APP_SECRET.
# Webhooks signed with either secret are accepted.
META_APP_SECRET=
# The server's fee payer pays for comment launches (about 0.02 SOL each). These cap the spend.
MAX_SERVER_LAUNCHES_PER_DAY=20
MIN_FEE_PAYER_SOL=0.1

# Claude names each comment-launched coin from the post's picture and caption, and checks the fan's
# lore (the words after the command) before it goes on-chain. It also checks a website launch's name,
# ticker and picture before the auto-poster posts it. Without a key, the name comes from the
# caption's first words (or the username), any lore is dropped, and website launches are not posted.
ANTHROPIC_API_KEY=

# The auto-poster: @instapaid.official posts the coins that go live, @mentioning the creator so they
# can claim (comment launches first; at most one post per creator a month; website launches only
# after Claude's check). Off unless AUTO_POST=1; it also needs IG_ACCESS_TOKEN (with
# instagram_business_content_publish) and an https PUBLIC_URL. Instagram's documents say 50 (and in
# places 100) API posts a day: the server never posts more than 50 in 24 hours, whatever this says.
AUTO_POST=0
# Posts in any 24 hours (0 stops posting).
POST_MAX_PER_DAY=25
# Minutes between two posts.
POST_MIN_GAP_MIN=20
# A coin not posted within this many hours is skipped (the post would be stale). 0 = never skip.
POST_MAX_AGE_H=24
# At most one post per creator in this many days, so nobody can make us @mention someone again and
# again (0 = no limit).
POST_CREATOR_GAP_DAYS=30
# 0 = never post website/extension launches (their name and picture are the launcher's choice).
POST_WEB_LAUNCHES=1
# How many coin addresses ending in "pump" to keep ready (found in the background); 0 = random addresses.
MINT_POOL_SIZE=10
# Where the cards are kept and served from (/posts/<mint>.jpg). Default: a "posts" folder beside DB_PATH.
POSTS_DIR=

# The launcher bot (src/scout.js): finds trending creators from public Instagram profiles and launches
# for the top one, paid by the fee payer. Both switches (Scouting, Auto-launch) are in /admin and start off.
# Usernames to start from (it also starts from every creator who has a coin, and follows related accounts).
SCOUT_SEEDS=
# Seconds between profile reads (slow on purpose; Instagram pauses the scout if it reads too fast).
SCOUT_INTERVAL_S=60
SCOUT_MIN_FOLLOWERS=10000
# 0 = no upper limit.
SCOUT_MAX_FOLLOWERS=0
SCOUT_MAX_LAUNCHES_PER_DAY=3
# The bot stops below this; kept above MIN_FEE_PAYER_SOL so comment launches keep their funds.
SCOUT_MIN_FEE_PAYER_SOL=0.5
# A creator's engagement per day this week (likes + 3 × comments) must reach this to be launched.
SCOUT_MIN_SCORE=1000
# Minutes between launches while Auto-launch is on.
SCOUT_LAUNCH_EVERY_MIN=60

# Token metadata upload (pump.fun's IPFS endpoint)
IPFS_UPLOAD_URL=https://pump.fun/api/ipfs

DB_PATH=./instapaid.db
