# Where the server listens and how people reach it (used in token metadata and the extension).
PORT=8787
PUBLIC_URL=https://instapaid.example

# Solana
RPC_URL=https://api.mainnet-beta.solana.com
# Server hot wallet (base58 or JSON array secret key). Pays claim network fees and comment
# launches. Web/extension launches are paid by the launcher's own wallet.
FEE_PAYER_SECRET=

# 32 random bytes, hex (openssl rand -hex 32). Encrypts every Instagram account's vault key at rest.
# Lose it and every unclaimed fee is lost. Rotate only with a re-encryption.
VAULT_MASTER_KEY=
# 32 random bytes, hex. Signs claim sessions.
SESSION_SECRET=

# Optional platform cut of each claim, in basis points (0 = none), sent to TREASURY_ADDRESS.
PLATFORM_FEE_BPS=0
TREASURY_ADDRESS=

# Instagram (Messaging API on the app's own Instagram professional account)
IG_BOT_USERNAME=instapaid.official
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=
IG_GRAPH_VERSION=v23.0

# Comment launches: "@<IG_BOT_USERNAME> make a token for this creator" under any public post.
# Needs the Instagram API with Facebook Login (a Facebook Page linked to the bot's account), with
# instagram_basic, instagram_manage_comments, pages_read_engagement, pages_show_list, and the
# webhook subscribed to "mentions". Leave IG_USER_ID empty to switch comment launches off.
IG_USER_ID=
IG_FB_ACCESS_TOKEN=
FB_GRAPH_VERSION=v23.0
# The server's fee payer pays for comment launches (about 0.02 SOL each). These cap the spend.
MAX_SERVER_LAUNCHES_PER_DAY=20
MIN_FEE_PAYER_SOL=0.1

# Claude writes each comment-launched coin's name, ticker and lore. Without a key, coins get a
# plain name (the username) and a one-line lore.
ANTHROPIC_API_KEY=

# Token metadata upload (pump.fun's IPFS endpoint)
IPFS_UPLOAD_URL=https://pump.fun/api/ipfs

DB_PATH=./instapaid.db
